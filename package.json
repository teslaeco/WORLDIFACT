{
  "name": "worldifact",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:http": "node scripts/http-smoke.mjs",
    "dev:api": "node --env-file-if-exists=.dev.vars server/dev.ts",
    "dev:worker": "wrangler dev --port 8787",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:http && npm run build",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler/preview",
    "deploy": "wrangler deploy",
    "prebuild": "node scripts/prepare-iss-assets.mjs",
    "foundations:build": "node scripts/build-foundations.mjs",
    "preverify": "node scripts/prepare-iss-assets.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "4.131.2"
  }
}
