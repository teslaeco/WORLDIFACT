
// Regression from the owner's old failed receipt + 1,000 held / 190 available.
// Exercise the actual Shop effects, not a replacement fixture component.
test('terminal failed request clears its unchanged composer, preserves its evidence and shows the real point blocker', async () => {
  const account = { ...fundedAccount, paidGenerationPolicy: PAID_POINTS_POLICY, credits: 1190, reservedCredits: 1000, availableCredits: 190,
    studioAdmission: admission(false, 'CREDITS_EXHAUSTED') }
  const h = await harness({ ready: true, detailedReady: true, accountLookup: () => Response.json(account),
    jobLookup: () => Response.json({ job: { id: oldId, state: 'failed', failureCode: 'ORACLE_JOB_FAILED', pointSettlement: { version: 1, state: 'pending-cost', heldPoints: 250, chargedPoints: 0 } } }) })
  try {
    const retained = h.storeData.get(clientModule.STUDIO_RECEIPT_KEY)
    await h.poll()
    assert.equal(h.byId('studio-prompt').props.value, '')
    assert.equal(h.storeData.get(clientModule.STUDIO_RECEIPT_KEY), retained)
    assert.equal(h.archive.get(oldId).sha256, 'original')
    assert.equal(h.button('Generate Astra/Blender model').props.disabled, true)
    assert.equal(h.quote().quote.reason, 'CREDITS_EXHAUSTED')
    assert.deepEqual(h.quote().balance, { total: 1190, held: 1000, available: 190 })
    assert.match(h.quoteMarkup(), /190 available points/)
    assert.match(h.quoteMarkup(), /Review existing held requests/)
    assert.doesNotMatch(h.quoteMarkup(), /Plans &amp; one-time prepaid credits/)
    const previous = h.all().find(n => n.type === 'details' && String(n.props.className).includes('shop-previous-failure'))
    assert.ok(previous)
    assert.equal(previous.props.open, undefined, 'old failure is collapsed by default, not presented as a new failure')
    assert.match(text(previous), /points held for cost review/)
    assert.equal(h.calls.filter(call => call.method !== 'GET').length, 0)
  } finally { h.close() }
})

test('late terminal result never clears a next prompt or references edited before it arrived', async () => {
  const h = await harness({ ready: true, detailedReady: true, state: 'failed', failureCode: 'ORACLE_JOB_FAILED' })
  try {
    h.byId('studio-prompt').props.onChange({ target: { value: 'My next globe, not the previous request' } })
    await h.settle()
    await h.byId('studio-photos').props.onChange({ target: { files: [{ name: 'new-view.png' }], value: 'new-view.png' } })
    await h.settle(); await h.poll()
    assert.equal(h.byId('studio-prompt').props.value, 'My next globe, not the previous request')
    assert.ok(h.all().some(n => n.type === 'img' && /Your reference 1/.test(n.props.alt || '')))
    assert.equal(h.calls.filter(call => call.method !== 'GET').length, 0)
  } finally { h.close() }
})

test('one completed reset does not erase a later draft on balance refresh or repeated same-job recovery', async () => {
  const h = await harness({ ready: true, detailedReady: true, state: 'failed', failureCode: 'ORACLE_JOB_FAILED' })
  try {
    await h.poll(); assert.equal(h.byId('studio-prompt').props.value, '')
    h.byId('studio-prompt').props.onChange({ target: { value: 'New draft after completion' } }); await h.settle()
    await h.balanceChanged()
    h.button('Recover this job / reload result').props.onClick(); await h.settle(); await h.poll()
    assert.equal(h.byId('studio-prompt').props.value, 'New draft after completion')
    assert.equal(h.calls.filter(call => call.method !== 'GET').length, 0)
  } finally { h.close() }
})

test('completed original model survives automatic composer reset without another generation or selection deletion', async () => {
  const h = await harness({ ready: true, detailedReady: true })
  try {
    await h.poll()
    assert.equal(h.byId('studio-prompt').props.value, '')
    assert.match(h.description(), /Original brown chess knight/)
    assert.ok(h.storeData.get(clientModule.STUDIO_RECEIPT_KEY))
    assert.equal(h.archive.get(oldId).sha256, 'original')
    assert.equal(h.calls.filter(call => call.method !== 'GET').length, 0)
  } finally { h.close() }
})

test('active or unverified requests do not clear the draft or allow replacement', async () => {
  for (const state of ['pending', 'building', 'generating']) {
    const h = await harness({ ready: true, detailedReady: true, state })
    try {
      await h.poll()
      assert.equal(h.byId('studio-prompt').props.value, 'Original brown chess knight')
      assert.equal(h.button('Generate Astra/Blender model').props.disabled, true)
      assert.equal(h.calls.filter(call => call.method !== 'GET').length, 0)
    } finally { h.close() }
  }
})

test('clear description also clears references when text is already empty without changing the prior model', async () => {
  const h = await harness({ ready: true, detailedReady: true })
  try {
    await h.poll()
    h.byId('studio-photos').props.onChange({ target: { files: [{ name: 'new-view.png' }], value: 'new-view.png' } })
    await h.settle()
    const clear = h.all().find(n => n.props['data-testid'] === 'clear-studio-draft')
    assert.equal(clear.props.disabled, false)
    clear.props.onClick(); await h.settle()
    assert.equal(h.byId('studio-prompt').props.value, '')
    assert.equal(h.all().some(n => n.type === 'img' && /Your reference 1/.test(n.props.alt || '')), false)
    assert.match(h.description(), /Original brown chess knight/)
    assert.equal(h.calls.filter(call => call.method !== 'GET').length, 0)
  } finally { h.close() }
})
