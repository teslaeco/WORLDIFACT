# Local server only. Copy to .dev.vars, which is ignored by git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Enable only after the owner approves paid API use and a hard request ceiling/expiry.
ENABLE_PAID_GENERATION=false
# Contest pilot: when true, no login/access code is required, so keep a tiny global Durable Object ceiling and short expiry.
PUBLIC_PILOT=false
# Separate Oracle/Blender write gate. Keep false until storage is healthy and an explicit cost-approved pilot is ready.
ENABLE_ORACLE_JOBS=false
# Private preview secret (32–256 random characters), never an OpenAI API key. Not required when PUBLIC_PILOT=true.
GENERATION_ACCESS_TOKEN=
# Absolute lifetime request ceiling, including failures. Zero disables LIVE.
GENERATION_REQUEST_LIMIT=0
# Explicit approved expiry as an ISO 8601 UTC timestamp.
GENERATION_EXPIRES_AT=

# Server-side payment configuration. Empty by default; never put private keys in VITE_*.
ENFORCE_ACCOUNT_ENTITLEMENTS=true
ACCOUNT_LEDGER_MODE=sandbox
ENABLE_BILLING=false
BILLING_PUBLIC_ORIGIN=https://worldifact.xodobrox.workers.dev
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time per-unit Price: exactly USD 30.00 for 1,500 credits.
STRIPE_TOPUP_PRICE_ID=
STRIPE_PREVIOUS_TOPUP_PRICE_IDS=
STRIPE_TOPUP_CREDITS=1500
# Recurring billing remains disabled until the owner chooses a period.
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_SUBSCRIPTION_INTERVAL=
ENABLE_PAYPAL_BILLING=false
PAYPAL_MODE=sandbox
# REST app credentials; the supplied HostedButtons SDK client ID is not a REST secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
# Configure Revolut payouts in the payment-provider dashboard. Never add bank details here.
