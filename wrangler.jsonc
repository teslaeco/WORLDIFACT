{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worldifact",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-6-astra",
    "ENABLE_PAID_GENERATION": "true",
    "PUBLIC_PILOT": "true",
    "ENABLE_ORACLE_JOBS": "true",
    "GENERATION_REQUEST_LIMIT": "10000",
    "GENERATION_EXPIRES_AT": "2026-09-20T23:59:59Z",
    "ENABLE_APPROVED_FAST_TEST": "false",
    "ENABLE_STUDIO_JOBS": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GENERATION_BUDGET",
        "class_name": "GenerationBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GenerationBudget"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "GENERATION_LIMITER",
      "namespace_id": "5122026",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
